        },
        {
            "name": "sys-gnu-release",
            "displayName": "Release_GNU",
            "configuration": "Release",
            "configurePreset": "sys-gnu"
        },
        {
            "name": "sys-llvm-debug",
            "displayName": "Debug_LLVM",
            "configuration": "Debug",
            "configurePreset": "sys-llvm"
        },
        {
            "name": "sys-llvm-release",
            "displayName": "Release_LLVM",
            "configuration": "Release",
            "configurePreset": "sys-llvm"
        }
    ]
}
