{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg-visula-studio",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "vcpkg-gnu",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "vcpkg-llvm",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            },
            "environment": {
                "RUST_BUILD_USE_VCPKG": "1"
            }
        },
        {
            "name": "sys-llvm",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "sys-llvm-all",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "OPEN_STG_ENABLE_DEVELOP_TOOLS":true,
                "OPEN_STG_DEVELOP_TOOLS_C_CODE_GENERATOR":"CLANG",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "sys-gnu-all",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "OPEN_STG_ENABLE_DEVELOP_TOOLS":true,
                "OPEN_STG_DEVELOP_TOOLS_C_CODE_GENERATOR":"CLANG",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "sys-gnu",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vcpkg-debug",
            "displayName": "Debug_VS",
            "configuration": "Debug",
            "configurePreset": "vcpkg-visula-studio",
            "nativeToolOptions": [
                "-Restore"
            ]
        },
        {
            "name": "vcpkg-release",
            "displayName": "Release_VS",
            "configuration": "Release",
            "configurePreset": "vcpkg-visula-studio",
            "nativeToolOptions": [
                "-Restore"
            ]
        },
        {
            "name": "vcpkg-gnu-debug",
            "displayName": "Debug_GNU",
            "configuration": "Debug",
            "configurePreset": "vcpkg-gnu"
        },
        {
            "name": "vcpkg-gnu-release",
            "displayName": "Release_GNU",
            "configuration": "Release",
            "configurePreset": "vcpkg-gnu"
        },
        {
            "name": "vcpkg-llvm-debug",
            "displayName": "Debug_LLVM",
            "configuration": "Debug",
            "configurePreset": "vcpkg-llvm"
        },
        {
            "name": "vcpkg-llvm-release",
            "displayName": "Release_LLVM",
            "configuration": "Release",
            "configurePreset": "vcpkg-llvm"
        },
        {
            "name": "sys-release",
            "displayName": "Release_VS",
            "configuration": "Release",
            "configurePreset": "vcpkg-visula-studio"
        },
        {
            "name": "sys-gnu-debug",
            "displayName": "Debug_GNU",
            "configuration": "Debug",
