{
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "version": 2,
    "configurePresets": [
        {
            "name": "basic-config",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_MAKE_PROGRAM": "ninja"
            }
        },
        {
            "name": "basic-gnu",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "basic-mingw-w64",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-cc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-c++"
            },
            "environment": {
                "VCPKG_DEFAULT_HOST_TRIPLET": "x64-mingw-dynamic",
                "VCPKG_DEFAULT_TRIPLET": "x64-mingw-dynamic"
            }
        },
        {
            "name": "basic-llvm-msvc",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_MAKE_PROGRAM": "ninja",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/Source.CMake/ToolchainFiles/LlvmMsvcToolchainFile.cmake"
            }
        },
        {
            "name": "basic-msvc",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "basic-vcpkg",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "basic-llvm",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "basic-options-msys2-defult-all",
            "hidden": true,
            "cacheVariables": {
                "OPEN_STG_ENABLE_LIBDWARF": true,
                "OPEN_STG_ENABLE_DEVELOP_TOOLS": true,
                "OPEN_STG_OPTION_STRING_PROCESSING_AUTO": true,
                "OPEN_STG_ENABLE_MCFGTHREAD": true,
                "OPEN_STG_ENABLE_UNIT_TESTS": true,
                "OPEN_STG_ENABLE_GAME_SERVER": true,
                "OPEN_STG_ENABLE_GAME_CLIENT": true
            }
        },
        {
            "name": "basic-options-mingw-defult-all",
            "hidden": true,
            "cacheVariables": {
                "OPEN_STG_ENABLE_MCFGTHREAD": false
            },
            "inherits": [
                "basic-options-msys2-defult-all"
            ]
        },
        {
            "name": "basic-options-vcpkg-defult-all",
            "hidden": true,
            "cacheVariables": {
                "OPEN_STG_OPTION_STRING_PROCESSING_AUTO": true,
                "OPEN_STG_ENABLE_LIBDWARF": true,
                "OPEN_STG_ENABLE_DEVELOP_TOOLS": true,
                "OPEN_STG_ENABLE_MCFGTHREAD": false,
                "OPEN_STG_ENABLE_UNIT_TESTS": true,
                "OPEN_STG_ENABLE_GAME_SERVER": true,
                "OPEN_STG_ENABLE_GAME_CLIENT": true
            }
        },
        {
            "name": "basic-options-unix-defult-all",
            "hidden": true,
            "cacheVariables": {
                "OPEN_STG_OPTION_STRING_PROCESSING_AUTO": true,
                "OPEN_STG_ENABLE_LIBDWARF": true,
                "OPEN_STG_ENABLE_DEVELOP_TOOLS": true,
                "OPEN_STG_ENABLE_MCFGTHREAD": false,
                "OPEN_STG_ENABLE_UNIT_TESTS": true,
                "OPEN_STG_ENABLE_GAME_SERVER": true,
                "OPEN_STG_ENABLE_GAME_CLIENT": true
            }
        },
        {
            "name": "unix-gnu-all",
            "inherits": [
                "basic-config",
                "basic-gnu",
                "basic-options-unix-defult-all"
            ]
        },
        {
            "name": "unix-llvm-all",
            "inherits": [
                "basic-config",
                "basic-llvm",
                "basic-options-unix-defult-all"
            ]
        },
        {
            "name": "msys2-gnu-x64-all",
            "inherits": [
                "basic-config",
                "basic-mingw-w64",
                "basic-options-msys2-defult-all"
            ]
        },
        {
            "name": "msys2-llvm-x64-all",
            "inherits": [
                "basic-config",
                "basic-llvm",
                "basic-options-msys2-defult-all"
            ]
        },
        {
            "name": "vcpkg-win32-msvc-x64-all",
            "binaryDir": "${sourceDir}/build/",
            "inherits": [
                "basic-config",
                "basic-llvm-msvc",
                "basic-vcpkg",
                "basic-options-vcpkg-defult-all"
            ]
        },
        {
            "name": "vcpkg-win32-mingw-x64-all",
            "binaryDir": "${sourceDir}/build/",
            "inherits": [
                "basic-config",
                "basic-mingw-w64",
                "basic-vcpkg",
                "basic-options-mingw-defult-all"
            ]
        }
    ],
    "buildPresets": []
}
