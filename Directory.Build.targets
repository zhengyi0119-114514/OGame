<?xml version="1.0" encoding="UTF-8"?>
<Project>
    <PropertyGroup
        Condition="'$(MSBuildProjectExtension)' == '.csproj' Or '$(MSBuildProjectExtension)' == '.fsproj' Or '$(MSBuildProjectExtension)' == '.vbproj'">
        <OGameIsDotnetProject Condition="'$(OGameIsDotnetProject)' == ''">true</OGameIsDotnetProject>
        <OGameDotnetProjectAotProject Condition="'$(OGameDotnetProjectAotProject)' == ''">false</OGameDotnetProjectAotProject>
        <PublishAot Condition="$(OGameDotnetProjectAotProject)">true</PublishAot>
        <NativeLib Condition="$(OGameDotnetProjectAotProject)">Shared</NativeLib>
        <UseNativeAot Condition="$(OGameDotnetProjectAotProject)">true</UseNativeAot>
        <SelfContained Condition="$(OGameDotnetProjectAotProject)">true</SelfContained>
    </PropertyGroup>
    <PropertyGroup
        Condition="$(RuntimeIdentifier.StartsWith('win')) And $(OGameDotnetProjectAotProject) And ('$(Configuration)|$(Platform)'=='Release|AnyCPU')">
        <InvariantGlobalization>true</InvariantGlobalization>
        <WindowsSupportedOSPlatformVersion>6.2</WindowsSupportedOSPlatformVersion>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <TargetPlatformMinVersion>6.2</TargetPlatformMinVersion>
        <SupportWinXP>true</SupportWinXP>
        <PublishAot>true</PublishAot>
    </PropertyGroup>
    <PropertyGroup
        Condition="$(OGameIsDotnetProject) And $(OGameDotnetProjectAotProject) And $(RuntimeIdentifier.StartsWith('win'))">
        <TargetFrameworks Condition="'$(TargetFrameworks)' != ''">$(TargetFrameworks);net10.0-windows</TargetFrameworks>
        <TargetFramework Condition="(Not ($(OGameDotnetProjectAotProject))) Or (Not $(RuntimeIdentifier.StartsWith('win'))">net10.0</TargetFramework>
        <TargetFramework Condition="$(OGameDotnetProjectAotProject) And $(RuntimeIdentifier.StartsWith('win')">net10.0-windows</TargetFramework>
    </PropertyGroup>
    <ItemGroup
        Condition="$(OGameDotnetProjectAotProject) And $(RuntimeIdentifier.StartsWith('win'))">
        <PackageReference Include="VC-LTL" Version="5.3.1" />
        <PackageReference Include="YY-Thunks" Version="1.1.9" />
    </ItemGroup>
</Project>