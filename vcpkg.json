{
    "dependencies": [
        "boost-program-options",
        "catch2",
        "libconfig",
        {
            "name": "sdl2",
            "features": [
                "vulkan"
            ]
        },
        {
            "name": "sdl2-image",
            "features": [
                "libjpeg-turbo",
                "libwebp"
            ]
        },
        "sdl2-ttf",
        {
            "name": "sdl2pp",
            "features": [
                "sdl2-image",
                "sdl2-ttf"
            ]
        },
        "spdlog"
    ]
}